{
  "name": "hip-templater",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based automatic templating for total hip arthroplasty on AP pelvis radiographs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:artifact": "node scripts/build-artifact.mjs",
    "eval": "vitest run --config vite.config.ts eval/"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "typescript": "~5.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "dicom-parser": "^1.8.21"
  }
}
